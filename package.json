{
  "name": "sms-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @sms/web\" \"npm run start:dev -w @sms/api\"",
    "dev:web": "npm run dev -w @sms/web",
    "dev:api": "npm run start:dev -w @sms/api",
    "prisma:generate": "npm run prisma:generate -w @sms/api",
    "prisma:migrate": "npm run prisma:migrate -w @sms/api"
  }
}
